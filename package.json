{
  "name": "diario-de-cargas",
  "version": "2.0.0",
  "private": true,
  "description": "Diário de Cargas — Berzerker Mode (PWA 100% local, sem build em produção)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o vendor/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o vendor/tailwind.css --watch",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node test_engine.js && node test_ui.js && node --experimental-vm-modules test_modules.js && node test_sw.js",
    "test:engine": "node test_engine.js",
    "test:ui": "node test_ui.js",
    "test:sw": "node test_sw.js",
    "test:modules": "node --experimental-vm-modules test_modules.js",
    "check:sw-core": "node scripts/check-sw.js",
    "check:sw": "node scripts/check-sw-version.js",
    "check:modules": "node --experimental-vm-modules scripts/check-modules.js",
    "check:docs": "node scripts/check-docs-paths.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "tailwindcss": "3.4.17"
  }
}
