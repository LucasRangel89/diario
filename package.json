{
  "name": "diario-de-cargas",
  "version": "2.0.0",
  "private": true,
  "description": "Diário de Cargas — Berzerker Mode (PWA 100% local, sem build em produção)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o vendor/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o vendor/tailwind.css --watch",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "test": "node test_engine.js && node test_ui.js",
    "test:engine": "node test_engine.js",
    "test:ui": "node test_ui.js",
    "check:sw": "node scripts/check-sw-version.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "tailwindcss": "3.4.17"
  }
}
